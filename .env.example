# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/karsa?schema=public"

# Set to true to enable the demo fixture data (seeded presentations + participants)
DEMO_MODE=false

# JWT signing secret — use a long random string in production
JWT_SECRET=your-strong-secret-here

# HTTP port the NestJS server listens on
PORT=3001

# Grace period (ms) before a session is paused after the presenter disconnects.
# Default: 10000 (10 s). Use 1500 for E2E tests (set via Playwright webServer env,
# not in this file — see playwright.config.ts in the frontend repo).
PRESENTER_GRACE_MS=10000

# Public base URL of this API (optional). Used for locally stored upload URLs;
# unset = derived from the request (https behind a proxy thanks to trust proxy).
# PUBLIC_URL=https://karsa-backend.onrender.com

# Allowed browser origins for HTTP + Socket.IO, comma-separated. Unset = allow all (local dev).
# CORS_ORIGIN=https://karsa.vercel.app

# Supabase Storage for uploaded images. When unset, images go to the local uploads/ folder
# (fine for development, lost on hosts with an ephemeral disk such as Render).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role key or secret key — server only, never expose>
# SUPABASE_STORAGE_BUCKET=karsa-assets

# Deployment guide (Vercel + Render + Supabase): docs/DEPLOY.md
